# Optional configuration. Environment variables take precedence.
# Provider selection: ollama, gemini, or openai.
LLM_PROVIDER=ollama

# Ollama (no API key required).
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://localhost:11434

# Blank uses the application default: gemini-2.5-flash.
GEMINI_MODEL=
# Required only for Gemini. Never commit a real API key.
GOOGLE_API_KEY=

# Blank uses the application default: gpt-5-mini.
OPENAI_MODEL=
# Required only for OpenAI. Never commit a real API key.
OPENAI_API_KEY=

# DEBUG, INFO, WARNING, ERROR, or CRITICAL (case-insensitive).
LOG_LEVEL=INFO
